generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                   String                          @id @default(cuid())
  email                                String                          @unique
  name                                 String?
  image                                String?
  role                                 Role                            @default(ATTENDANT)
  isActive                             Boolean                         @default(true)
  createdAt                            DateTime                        @default(now())
  updatedAt                            DateTime                        @updatedAt
  attendantCategory                    AttendantCategory?
  password                             String?
  actionLogs                           ActionLog[]
  activities                           AttendantActivity[]
  categoryAssignments                  AttendantCategoryAssignment[]
  attendantCommissions                 AttendantCommission[]
  attendantCompPlan                    AttendantCompPlan?
  attendantPayrollAdjustments          AttendantPayrollAdjustment[]
  recurringPayrollItems                AttendantRecurringPayrollItem[]
  payrollAdjustmentRequests            PayrollAdjustmentRequest[]      @relation("PayrollAdjustmentRequestAttendant")
  submittedPayrollAdjustmentRequests   PayrollAdjustmentRequest[]      @relation("PayrollAdjustmentRequestRequester")
  decidedPayrollAdjustmentRequests     PayrollAdjustmentRequest[]      @relation("PayrollAdjustmentRequestDecider")
  leaveRequests                        LeaveRequest[]                  @relation("LeaveRequestUser")
  approvedLeaveRequests                LeaveRequest[]                  @relation("LeaveRequestApprover")
  leaveBalance                         LeaveBalance?
  cashAdvances                         CashAdvance[]                   @relation("CashAdvanceUser")
  approvedCashAdvances                 CashAdvance[]                   @relation("CashAdvanceApprover")
  leaveBalancesUpdated                 LeaveBalance[]                  @relation("LeaveBalanceUpdatedBy")
  balance                              Balance?
  commissionConfig                     UserCommissionConfig?
  commissionEarnings                   CommissionEarning[]
  commissionRecords                    CommissionRecord[]
  dailyReports                         DailyReport[]
  marketingEntries                     MarketingDailyEntry[]
  marketplaceAccountAssignments        MarketplaceAccountAssignment[]  @relation("MarketplaceAccountAssignment_attendant")
  marketplaceOrdersPriced              MarketplaceOrder[]              @relation("MarketplaceOrder_pricedBy")
  marketplacePricingTemplatesUpdated   MarketplacePricingTemplate[]    @relation("MarketplacePricingTemplate_updatedBy")
  marketplaceReturnsAttended           MarketplaceReturn[]             @relation("MarketplaceReturn_attendant")
  marketplaceReturnsProcessed          MarketplaceReturn[]             @relation("MarketplaceReturn_processedBy")
  marketplaceReturnAttachmentsUploaded MarketplaceReturnAttachment[]   @relation("MarketplaceReturnAttachment_uploadedBy")
  orders                               Order[]
  issuedReceipts                       Receipt[]                       @relation("issuedBy")
  returnsApproved                      ReturnCase[]                    @relation("ReturnApprovedBy")
  returnsCreated                       ReturnCase[]                    @relation("ReturnCreatedBy")
  evidenceTaken                        ReturnEvidence[]                @relation("EvidenceTaker")
  returnPickups                        ReturnPickup[]                  @relation("PickupAssignee")
  assignments                          ShopAssignment[]
  supportEntries                       SupportDailyEntry[]
  userShops                            UserShop[]
  weeklySalesApproved                  WeeklySale[]                    @relation("WeeklySaleApproval")
  weeklySales                          WeeklySale[]                    @relation("WeeklySaleAttendant")
  marketplaceProfitEntries             MarketplaceProfitEntry[]        @relation("MarketplaceProfitEntryEnteredBy")
  marketplaceStatementDraftsCreated    MarketplaceStatementDraft[]     @relation("MarketplaceStatementDraftCreatedBy")
  managedShops                         Shop[]                          @relation("ManagedBy")
  agentProfile                         AgentProfile?
  agentSales                           AgentSale[]                     @relation("AgentSaleAgent")
  agentCommissions                     AgentCommission[]               @relation("AgentCommissionAgent")
  agentPayouts                         AgentPayout[]                   @relation("AgentPayoutAgent")
  agentActivityLogs                    AgentActivityLog[]              @relation("AgentActivityAgent")
  ownedAgentLeads                      AgentLeadOwnership[]            @relation("AgentLeadOwnershipAgent")
  primaryDuplicateReviews              AgentDuplicateReview[]          @relation("AgentDuplicatePrimaryAgent")
  secondaryDuplicateReviews            AgentDuplicateReview[]          @relation("AgentDuplicateAgent")
  resolvedDuplicateReviews             AgentDuplicateReview[]          @relation("AgentDuplicateResolvedBy")
  agentFraudSignals                    AgentFraudSignal[]              @relation("AgentFraudSignalAgent")
  reviewedAgentFraudSignals            AgentFraudSignal[]              @relation("AgentFraudSignalReviewedBy")
  agentAuditActions                    AgentAuditLog[]                 @relation("AgentAuditActor")
  agentAuditTargets                    AgentAuditLog[]                 @relation("AgentAuditTargetAgent")
  agentSaleTimelineActions             AgentSaleTimeline[]             @relation("AgentSaleTimelineActor")
}

model AgentSale {
  id                      String                 @id @default(cuid())
  agentId                 String
  customerName            String
  customerPhone           String
  customerLocation        String
  customerCounty          String?
  productName             String
  productCategory         String?
  quantity                Float                  @default(1)
  unitPrice               Float                  @default(0)
  totalAmount             Float                  @default(0)
  paymentType             String
  amountPaid              Float                  @default(0)
  mpesaReference          String?
  deliveryMethod          String?
  deliveryNotes           String?
  customerNotes           String?
  internalAgentNotes      String?
  status                  String                 @default("pending_review")
  commissionPct           Float                  @default(6)
  potentialCommission     Float                  @default(0)
  commissionLocked        Boolean                @default(true)
  receiptId               String?
  receiptNumber           String?
  completedAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  agent                   User                   @relation("AgentSaleAgent", fields: [agentId], references: [id], onDelete: Cascade)
  receipt                 Receipt?               @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  leadOwnerships          AgentLeadOwnership[]   @relation("AgentLeadOwnershipFirstSale")
  primaryDuplicateReviews AgentDuplicateReview[] @relation("AgentDuplicatePrimarySale")
  duplicateReviews        AgentDuplicateReview[] @relation("AgentDuplicateSale")
  fraudSignals            AgentFraudSignal[]     @relation("AgentFraudSignalSale")
  auditLogs               AgentAuditLog[]        @relation("AgentAuditSale")
  timelineEntries         AgentSaleTimeline[]

  @@index([agentId, createdAt])
  @@index([status, createdAt])
  @@index([paymentType, createdAt])
  @@index([receiptId])
  @@index([customerPhone, createdAt])
  @@index([customerName, createdAt])
}

model AgentProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  referralCode    String    @unique
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  nationalId      String?
  kraPin          String?
  gender          String?
  dateOfBirth     DateTime?
  country         String?
  county          String?
  city            String?
  address         String?
  idFrontUrl      String?
  idBackUrl       String?
  profilePhotoUrl String?
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model AgentCommission {
  id            String   @id @default(cuid())
  agentId       String
  sourceType    String
  sourceId      String?
  orderNumber   String?
  saleAmount    Float    @default(0)
  commissionPct Float    @default(0)
  commissionAmt Float    @default(0)
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  agent         User     @relation("AgentCommissionAgent", fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([status, createdAt])
}

model AgentPayout {
  id        String          @id @default(cuid())
  agentId   String
  amount    Float
  method    String?
  phone     String?
  reference String?
  status    String          @default("pending")
  createdAt DateTime        @default(now())
  agent     User            @relation("AgentPayoutAgent", fields: [agentId], references: [id], onDelete: Cascade)
  auditLogs AgentAuditLog[] @relation("AgentAuditPayout")

  @@index([agentId, createdAt])
  @@index([status, createdAt])
  @@index([reference])
}

model AgentActivityLog {
  id          String   @id @default(cuid())
  agentId     String
  action      String
  description String?
  createdAt   DateTime @default(now())
  agent       User     @relation("AgentActivityAgent", fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

model AgentLeadOwnership {
  id               String    @id @default(cuid())
  normalizedPhone  String
  customerName     String?
  customerCounty   String?
  customerLocation String?
  productName      String?
  agentId          String
  firstSaleId      String
  status           String    @default("active")
  ownedUntil       DateTime
  releasedAt       DateTime?
  overrideNote     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  agent            User      @relation("AgentLeadOwnershipAgent", fields: [agentId], references: [id], onDelete: Cascade)
  firstSale        AgentSale @relation("AgentLeadOwnershipFirstSale", fields: [firstSaleId], references: [id], onDelete: Cascade)

  @@index([normalizedPhone, ownedUntil])
  @@index([agentId, status])
  @@index([firstSaleId])
}

model AgentDuplicateReview {
  id               String          @id @default(cuid())
  normalizedPhone  String
  primarySaleId    String
  duplicateSaleId  String
  primaryAgentId   String
  duplicateAgentId String
  status           String          @default("open")
  resolutionNote   String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  primarySale      AgentSale       @relation("AgentDuplicatePrimarySale", fields: [primarySaleId], references: [id], onDelete: Cascade)
  duplicateSale    AgentSale       @relation("AgentDuplicateSale", fields: [duplicateSaleId], references: [id], onDelete: Cascade)
  primaryAgent     User            @relation("AgentDuplicatePrimaryAgent", fields: [primaryAgentId], references: [id], onDelete: Cascade)
  duplicateAgent   User            @relation("AgentDuplicateAgent", fields: [duplicateAgentId], references: [id], onDelete: Cascade)
  resolvedBy       User?           @relation("AgentDuplicateResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  auditLogs        AgentAuditLog[] @relation("AgentAuditDuplicateReview")

  @@unique([primarySaleId, duplicateSaleId])
  @@index([normalizedPhone, status])
  @@index([duplicateAgentId, status])
}

model AgentFraudSignal {
  id           String     @id @default(cuid())
  agentId      String?
  saleId       String?
  signalType   String
  riskLevel    String
  title        String
  description  String?
  status       String     @default("open")
  metadata     Json?
  reviewedById String?
  resolvedAt   DateTime?
  createdAt    DateTime   @default(now())
  agent        User?      @relation("AgentFraudSignalAgent", fields: [agentId], references: [id], onDelete: SetNull)
  sale         AgentSale? @relation("AgentFraudSignalSale", fields: [saleId], references: [id], onDelete: SetNull)
  reviewedBy   User?      @relation("AgentFraudSignalReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, riskLevel, createdAt])
  @@index([agentId, createdAt])
  @@index([saleId])
}

model AgentAuditLog {
  id                String                @id @default(cuid())
  actorUserId       String?
  targetAgentId     String?
  saleId            String?
  payoutId          String?
  duplicateReviewId String?
  eventType         String
  summary           String
  metadata          Json?
  createdAt         DateTime              @default(now())
  actor             User?                 @relation("AgentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetAgent       User?                 @relation("AgentAuditTargetAgent", fields: [targetAgentId], references: [id], onDelete: SetNull)
  sale              AgentSale?            @relation("AgentAuditSale", fields: [saleId], references: [id], onDelete: SetNull)
  payout            AgentPayout?          @relation("AgentAuditPayout", fields: [payoutId], references: [id], onDelete: SetNull)
  duplicateReview   AgentDuplicateReview? @relation("AgentAuditDuplicateReview", fields: [duplicateReviewId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([targetAgentId, createdAt])
  @@index([saleId, createdAt])
  @@index([payoutId, createdAt])
}

model AgentSaleTimeline {
  id          String    @id @default(cuid())
  saleId      String
  stage       String
  note        String?
  actorUserId String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  sale        AgentSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  actor       User?     @relation("AgentSaleTimelineActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([saleId, createdAt])
  @@index([stage, createdAt])
}

model AttendantActivity {
  id           String            @id @default(cuid())
  userId       String
  category     AttendantCategory
  metric       String
  numericValue Decimal?          @db.Decimal(18, 2)
  intValue     Int?
  notes        String?
  entryDate    DateTime          @default(now())
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id])

  @@index([userId, entryDate])
  @@index([category, metric, entryDate])
}

model AttendantCompPlan {
  id                        String       @id @default(cuid())
  attendantId               String       @unique
  baseSalary                Int
  frequency                 PayFrequency @default(PERIOD)
  defaultChamaDeduction     Int?
  defaultOtherDeduction     Int?
  defaultTransportAllowance Int?
  isActive                  Boolean      @default(true)
  notes                     String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  attendant                 User         @relation(fields: [attendantId], references: [id])
}

model AttendantPayrollAdjustment {
  id              String                         @id @default(cuid())
  attendantId     String
  periodKey       String
  periodLabel     String
  adjustmentType  PayrollAdjustmentType
  label           String
  amount          Int
  createdById     String
  recurringItemId String?
  occurrenceDate  DateTime?
  createdAt       DateTime                       @default(now())
  adjustmentKind  PayrollAdjustmentKind          @default(DEDUCTION)
  attendant       User                           @relation(fields: [attendantId], references: [id])
  recurringItem   AttendantRecurringPayrollItem? @relation(fields: [recurringItemId], references: [id])
  request         PayrollAdjustmentRequest?

  @@unique([recurringItemId, periodKey, occurrenceDate])
  @@index([attendantId, periodKey])
  @@index([recurringItemId, periodKey])
}

model AttendantRecurringPayrollItem {
  id             String                       @id @default(cuid())
  attendantId    String
  label          String
  adjustmentType PayrollAdjustmentType
  adjustmentKind PayrollAdjustmentKind        @default(DEDUCTION)
  amount         Int
  cadence        PayrollAdjustmentCadence
  dayOfWeek      Int?
  dayOfMonth     Int?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean                      @default(true)
  createdById    String
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  attendant      User                         @relation(fields: [attendantId], references: [id])
  adjustments    AttendantPayrollAdjustment[]

  @@index([attendantId, isActive])
}

model PayrollAdjustmentRequest {
  id                  String                      @id @default(cuid())
  attendantId         String
  requestedById       String
  decidedById         String?
  payrollAdjustmentId String?                     @unique
  periodKey           String
  periodLabel         String
  adjustmentType      PayrollAdjustmentType
  adjustmentKind      PayrollAdjustmentKind       @default(DEDUCTION)
  offenseType         String
  label               String
  amount              Int
  incidentDate        DateTime?
  details             String
  evidenceUrl         String?
  status              WellnessRequestStatus       @default(PENDING)
  adminComment        String?
  decidedAt           DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  attendant           User                        @relation("PayrollAdjustmentRequestAttendant", fields: [attendantId], references: [id])
  requestedBy         User                        @relation("PayrollAdjustmentRequestRequester", fields: [requestedById], references: [id])
  decidedBy           User?                       @relation("PayrollAdjustmentRequestDecider", fields: [decidedById], references: [id])
  payrollAdjustment   AttendantPayrollAdjustment? @relation(fields: [payrollAdjustmentId], references: [id])

  @@index([attendantId, periodKey])
  @@index([requestedById, createdAt])
  @@index([status, createdAt])
}

model LeaveBalance {
  id                   String   @id @default(cuid())
  userId               String   @unique
  annualEntitlement    Int      @default(21)
  sickEntitlement      Int      @default(10)
  emergencyEntitlement Int      @default(5)
  annualUsed           Int      @default(0)
  sickUsed             Int      @default(0)
  emergencyUsed        Int      @default(0)
  updatedById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedBy            User?    @relation("LeaveBalanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model LeaveRequest {
  id                    String                @id @default(cuid())
  userId                String
  startDate             DateTime              @db.Date
  endDate               DateTime              @db.Date
  type                  LeaveRequestType
  status                WellnessRequestStatus @default(PENDING)
  daysRequested         Int
  reason                String
  supportingDocumentUrl String?
  managerComment        String?
  approvedById          String?
  decidedAt             DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User                  @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy            User?                 @relation("LeaveRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CashAdvance {
  id                String                   @id @default(cuid())
  userId            String
  requestedAmount   Int
  approvedAmount    Int?
  status            WellnessRequestStatus    @default(PENDING)
  reason            String
  repaymentPeriod   Int?
  installmentAmount Int?
  remainingBalance  Int                      @default(0)
  hrComment         String?
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation("CashAdvanceUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy        User?                    @relation("CashAdvanceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  installments      CashAdvanceInstallment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CashAdvanceInstallment {
  id                  String      @id @default(cuid())
  cashAdvanceId       String
  dueDate             DateTime    @db.Date
  periodKey           String
  periodLabel         String
  sequenceNumber      Int
  amount              Int
  isPaid              Boolean     @default(false)
  deductedAt          DateTime?
  payrollAdjustmentId String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  cashAdvance         CashAdvance @relation(fields: [cashAdvanceId], references: [id], onDelete: Cascade)

  @@index([cashAdvanceId, dueDate])
  @@index([isPaid, dueDate])
}

model UserCommissionConfig {
  id                  String              @id @default(cuid())
  userId              String              @unique
  posTotalsMode       PosTotalsMode       @default(NONE)
  salesCommissionMode SalesCommissionMode @default(DEFAULT_TIERS)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyReport {
  id                       String      @id @default(cuid())
  date                     DateTime
  userId                   String?
  productsCount            Int
  totalSales               Decimal     @db.Decimal(12, 2)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  /// Day of the week (MONDAY–SATURDAY)
  day                      String
  /// Dynamic task results keyed by field name, stored as JSON
  tasks                    Json?
  /// Free-text submitter (keeps a copy of whatever the client provided)
  submittedBy              String?
  newProducts              Int?        @default(0)
  productsEdited           Int?        @default(0)
  copiesUploaded           Int?        @default(0)
  walkInServed             Int?        @default(0)
  purchasesMade            Int?        @default(0)
  liveSessionsCount        Int?        @default(0)
  commissionEarned         Decimal?    @db.Decimal(12, 2)
  confirmedCompetitiveness Boolean?    @default(false)
  marketEngagement         Json?
  concerns                 String?
  user                     User?       @relation(fields: [userId], references: [id])
  sales                    DailySale[]

  @@index([date])
  @@index([userId])
}

model DailySale {
  id             String          @id @default(cuid())
  dailyReportId  String
  productName    String
  price          Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  paymentMethod  PaymentMethod?
  receiptNumber  String?
  dailyReport    DailyReport     @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  marketingSales MarketingSale[]

  @@index([dailyReportId])
}

model MarketingDailyEntry {
  id                             String             @id @default(cuid())
  date                           DateTime
  dayOfWeek                      String
  totalSales                     Int                @default(0)
  totalProfit                    Int                @default(0)
  photoUrl                       String?
  tiktokPosted2Videos            Boolean?
  tiktokRepliedAll               Boolean?
  igFbYtPosted2VideosEach        Boolean?
  igFbYtRepliedAll               Boolean?
  waPostedStatus                 Boolean?
  waSavedContacts                Boolean?
  waRespondedAll                 Boolean?
  waPosted10Statuses             Boolean?
  waSaved10Contacts              Boolean?
  stockEnoughFastMovers          Boolean?
  shot4ProductVideos             Boolean?
  tiktokPosted4ExplanatoryVideos Boolean?
  liveViewers                    Int?
  liveSessionsCount              Int?
  liveSessionsEstimatedViewers   Int?
  liveSessionDurationMinutes     Int?
  liveSessionPlatform            String?
  shopCleaned                    Boolean?
  shopWellArranged               Boolean?
  displayWellLabeled             Boolean?
  weeklyComment                  String?
  payload                        Json?
  submittedById                  String?
  submittedByName                String?
  submittedByEmail               String?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  weeklyMeetingAttended          Boolean?           @default(false)
  weeklyVideoCount               Int?               @default(0)
  weeklyVideoShootParticipated   Boolean?           @default(false)
  submittedBy                    User?              @relation(fields: [submittedById], references: [id])
  receipts                       MarketingReceipt[]
  sales                          MarketingSale[]

  @@index([date])
  @@index([dayOfWeek])
  @@index([submittedById])
}

model MarketingSale {
  id            String              @id @default(cuid())
  entryId       String
  product       String
  buyingPrice   Int
  sellingPrice  Int
  receiptNumber String?
  paymentMethod PaymentMethod
  createdAt     DateTime            @default(now())
  itemsCount    Int                 @default(1)
  dailySaleId   String?
  pricedAt      DateTime?           @db.Timestamptz(6)
  dailySale     DailySale?          @relation(fields: [dailySaleId], references: [id])
  entry         MarketingDailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([pricedAt])
  @@index([dailySaleId])
}

model MarketingReceipt {
  id            String                 @id @default(cuid())
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  dailyEntryId  String
  receiptNumber String?
  receiptKey    String?                @unique
  sellingTotal  Int
  paymentMethod PaymentMethod
  buyingTotal   Int                    @default(0)
  dailyEntry    MarketingDailyEntry    @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  items         MarketingReceiptItem[]

  @@unique([dailyEntryId, receiptNumber, paymentMethod], name: "uniq_marketing_receipt_in_entry")
  @@index([dailyEntryId])
}

model MarketingReceiptItem {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  receiptId   String
  productName String
  buyingPrice Int
  receipt     MarketingReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model SupportDailyEntry {
  id               String           @id @default(cuid())
  date             DateTime
  dayOfWeek        String
  totalSales       Int              @default(0)
  totalProfit      Int              @default(0)
  newBatteries     Int              @default(0)
  changedBatteries Int              @default(0)
  submittedById    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  submittedBy      User?            @relation(fields: [submittedById], references: [id])
  receipts         SupportReceipt[] @relation("SupportEntryReceipts")
  sales            SupportSale[]    @relation("SupportEntrySales")

  @@index([date])
  @@index([submittedById])
}

model SupportSale {
  id            String            @id @default(cuid())
  entryId       String
  product       String
  buyingPrice   Int
  sellingPrice  Int
  receiptNumber String?
  paymentMethod PaymentMethod
  itemsCount    Int               @default(1)
  createdAt     DateTime          @default(now())
  entry         SupportDailyEntry @relation("SupportEntrySales", fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model SupportReceipt {
  id            String               @id @default(cuid())
  dailyEntryId  String
  receiptNumber String?
  receiptKey    String?              @unique
  sellingTotal  Int
  paymentMethod PaymentMethod
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  buyingTotal   Int                  @default(0)
  dailyEntry    SupportDailyEntry    @relation("SupportEntryReceipts", fields: [dailyEntryId], references: [id], onDelete: Cascade)
  items         SupportReceiptItem[] @relation("SupportReceiptItems")

  @@unique([dailyEntryId, receiptNumber, paymentMethod], name: "uniq_support_receipt_in_entry")
  @@index([dailyEntryId])
}

model SupportReceiptItem {
  id          String         @id @default(cuid())
  receiptId   String
  productName String
  buyingPrice Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  pricedAt    DateTime?      @db.Timestamptz(6)
  receipt     SupportReceipt @relation("SupportReceiptItems", fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([pricedAt])
}

model Shop {
  id                         String                      @id @default(cuid())
  name                       String
  location                   String?
  phone                      String?
  email                      String?
  isActive                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  platform                   Platform                    @default(JUMIA)
  credentialsEncrypted       Json?
  /// When true, automated sync jobs should skip fetching orders for this shop.
  disableAutoSync            Boolean                     @default(false)
  apiCredentials             ApiCredential[]
  attendantCommissions       AttendantCommission[]
  commissionRules            CommissionRule[]
  costCatalogs               CostCatalog[]
  discrepancies              Discrepancy[]
  fulfillmentAudits          FulfillmentAudit[]
  orders                     Order[]
  reconciliations            Reconciliation[]
  returnCases                ReturnCase[]
  settlementRows             SettlementRow[]
  apiConfig                  ShopApiConfig?
  assignments                ShopAssignment[]
  userAssignments            UserShop[]
  weeklySales                WeeklySale[]
  marketplaceStatementDrafts MarketplaceStatementDraft[]
  jumiaShopSid               String?
  managers                   User[]                      @relation("ManagedBy")

  @@unique([platform, jumiaShopSid])
}

/// WeeklySale records aggregate the total sales for a given attendant (user) and shop
/// over a Monday→Sunday week. Each record can be marked as PENDING or PAID.
model WeeklySale {
  id         String           @id @default(cuid())
  shopId     String?
  userId     String?
  weekStart  DateTime         @db.Timestamptz(0)
  weekEnd    DateTime         @db.Timestamptz(3)
  amount     Decimal          @db.Decimal(12, 2)
  createdAt  DateTime         @default(now())
  platform   Platform
  source     WeeklySaleSource
  createdBy  String?
  approvedBy String?
  updatedAt  DateTime         @default(now()) @updatedAt
  status     WeeklySaleStatus @default(PENDING)
  approved   User?            @relation("WeeklySaleApproval", fields: [approvedBy], references: [id])
  shop       Shop?            @relation(fields: [shopId], references: [id])
  user       User?            @relation("WeeklySaleAttendant", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([shopId, platform, weekStart, weekEnd])
  @@index([shopId, platform, weekStart, weekEnd])
}

/// MarketplaceProfitEntry stores per-transaction economics for marketplace sales (e.g. Jumia item credit + fees).
/// These entries power Online Ops → Performance dashboards (profit, margin, loss monitoring) and are entered by admins.
model MarketplaceProfitEntry {
  id       String   @id @default(cuid())
  platform Platform
  date     DateTime @db.Timestamptz(3)

  /// Canonical Nairobi Mon→next Mon week window (exclusive weekEnd) for grouping.
  weekStart DateTime @db.Timestamptz(0)
  weekEnd   DateTime @db.Timestamptz(3)

  /// 25th→24th trading period key at the time of entry.
  periodKey String

  accountId String
  account   MarketplaceAccount @relation(fields: [accountId], references: [id])

  itemCreditTxn    String
  itemCreditAmount Decimal @db.Decimal(12, 2)
  commissionTxn    String?
  commissionAmount Decimal @db.Decimal(12, 2)
  shippingTxn      String?
  shippingAmount   Decimal @db.Decimal(12, 2)

  netPayout Decimal @db.Decimal(12, 2)

  buyingPrice       Decimal @db.Decimal(12, 2)
  profit            Decimal @db.Decimal(12, 2)
  marginPct         Decimal @db.Decimal(8, 2)
  commissionRatePct Decimal @db.Decimal(8, 2)
  isLoss            Boolean @default(false)

  orderId     String?
  sku         String?
  productName String?

  rawText String

  enteredByAdminId String
  enteredByAdmin   User   @relation("MarketplaceProfitEntryEnteredBy", fields: [enteredByAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([accountId, itemCreditTxn])
  @@index([platform, date])
  @@index([weekStart, weekEnd])
  @@index([periodKey])
  @@index([enteredByAdminId, createdAt])
}

/// MarketplaceStatementDraft stores a parsed statement "work-in-progress" for a specific shop + week.
/// It allows admins/supervisors to load a CSV once, then submit buying prices per order incrementally.
model MarketplaceStatementDraft {
  id       String   @id @default(cuid())
  draftKey String   @unique
  platform Platform

  /// Shop is used for WeeklySale linkage and manual weekly views.
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  /// Marketplace account powers profit entry linkage.
  accountId String
  account   MarketplaceAccount @relation(fields: [accountId], references: [id])

  weekStart DateTime @db.Timestamptz(0)
  weekEnd   DateTime @db.Timestamptz(3)
  periodKey String

  statementNumber String?
  fileName        String?
  rowCount        Int
  totalNetPayout  Decimal @db.Decimal(14, 2)

  /// Aggregated order rows (JSON array).
  rows           Json
  /// Buying price map keyed by itemCreditTxn.
  buyingByTxn    Json?
  /// Submitted profit-entry ids keyed by itemCreditTxn.
  submittedByTxn Json?

  createdById String
  createdBy   User   @relation("MarketplaceStatementDraftCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([shopId, weekStart])
  @@index([accountId, weekStart])
}

