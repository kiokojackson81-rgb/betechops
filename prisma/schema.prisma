generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                        @id @default(cuid())
  email                       String                        @unique
  name                        String?
  image                       String?
  role                        Role                          @default(ATTENDANT)
  isActive                    Boolean                       @default(true)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  attendantCategory           AttendantCategory?
  password                    String?
  actionLogs                  ActionLog[]
  activities                  AttendantActivity[]
  categoryAssignments         AttendantCategoryAssignment[]
  attendantCommissions        AttendantCommission[]
  attendantCompPlan           AttendantCompPlan?
  attendantPayrollAdjustments AttendantPayrollAdjustment[]
  commissionEarnings          CommissionEarning[]
  dailyReports                DailyReport[]
  marketingEntries            MarketingDailyEntry[]
  orders                      Order[]
  weeklySales                 WeeklySale[]              @relation("WeeklySaleAttendant")
  weeklySalesApproved         WeeklySale[]              @relation("WeeklySaleApproval")
  issuedReceipts              Receipt[]                    @relation("issuedBy")
  returnsApproved             ReturnCase[]                  @relation("ReturnApprovedBy")
  returnsCreated              ReturnCase[]                  @relation("ReturnCreatedBy")
  evidenceTaken               ReturnEvidence[]              @relation("EvidenceTaker")
  returnPickups               ReturnPickup[]                @relation("PickupAssignee")
  assignments                 ShopAssignment[]
  supportEntries              SupportDailyEntry[]
  userShops                   UserShop[]
  managedShops                Shop[]                        @relation("ManagedBy")
  // Marketplace relations (added to satisfy new marketplace models)
  marketplaceAccountAssignments MarketplaceAccountAssignment[] @relation("MarketplaceAccountAssignment_attendant")
  marketplaceOrdersPriced      MarketplaceOrder[] @relation("MarketplaceOrder_pricedBy")
  marketplacePricingTemplatesUpdated MarketplacePricingTemplate[] @relation("MarketplacePricingTemplate_updatedBy")
  marketplaceReturnsAttended   MarketplaceReturn[] @relation("MarketplaceReturn_attendant")
  marketplaceReturnsProcessed  MarketplaceReturn[] @relation("MarketplaceReturn_processedBy")
  marketplaceReturnAttachmentsUploaded MarketplaceReturnAttachment[] @relation("MarketplaceReturnAttachment_uploadedBy")
  // One-to-one balance for commission payouts
  balance                     Balance?
  // Commission records assigned to this attendant
  commissionRecords           CommissionRecord[]
}

model AttendantActivity {
  id           String            @id @default(cuid())
  userId       String
  category     AttendantCategory
  metric       String
  numericValue Decimal?          @db.Decimal(18, 2)
  intValue     Int?
  notes        String?
  entryDate    DateTime          @default(now())
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id])

  @@index([userId, entryDate])
  @@index([category, metric, entryDate])
}

model AttendantCompPlan {
  id                        String       @id @default(cuid())
  attendantId               String       @unique
  baseSalary                Int
  frequency                 PayFrequency @default(PERIOD)
  defaultChamaDeduction     Int?
  defaultOtherDeduction     Int?
  defaultTransportAllowance Int?
  isActive                  Boolean      @default(true)
  notes                     String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  attendant                 User         @relation(fields: [attendantId], references: [id])
}

model AttendantPayrollAdjustment {
  id             String                @id @default(cuid())
  attendantId    String
  periodKey      String
  periodLabel    String
  adjustmentType PayrollAdjustmentType
  label          String
  amount         Int
  createdById    String
  createdAt      DateTime              @default(now())
  attendant      User                  @relation(fields: [attendantId], references: [id])

  @@index([attendantId, periodKey])
}

model DailyReport {
  id                       String      @id @default(cuid())
  date                     DateTime
  userId                   String?
  productsCount            Int
  totalSales               Decimal     @db.Decimal(12, 2)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  /// Day of the week (MONDAY–SATURDAY)
  day                      String
  /// Dynamic task results keyed by field name, stored as JSON
  tasks                    Json?
  /// Free-text submitter (keeps a copy of whatever the client provided)
  submittedBy              String?
  newProducts              Int?        @default(0)
  productsEdited           Int?        @default(0)
  copiesUploaded           Int?        @default(0)
  walkInServed             Int?        @default(0)
  purchasesMade            Int?        @default(0)
  liveSessionsCount        Int?        @default(0)
  commissionEarned         Decimal?    @db.Decimal(12, 2)
  confirmedCompetitiveness Boolean?    @default(false)
  marketEngagement         Json?
  concerns                 String?
  user                     User?       @relation(fields: [userId], references: [id])
  sales                    DailySale[]

  @@index([date])
  @@index([userId])
}

model DailySale {
  id             String          @id @default(cuid())
  dailyReportId  String
  productName    String
  price          Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  paymentMethod  PaymentMethod?
  receiptNumber  String?
  dailyReport    DailyReport     @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  marketingSales MarketingSale[]

  @@index([dailyReportId])
}

model MarketingDailyEntry {
  id                             String             @id @default(cuid())
  date                           DateTime
  dayOfWeek                      String
  totalSales                     Int                @default(0)
  totalProfit                    Int                @default(0)
  photoUrl                       String?
  tiktokPosted2Videos            Boolean?
  tiktokRepliedAll               Boolean?
  igFbYtPosted2VideosEach        Boolean?
  igFbYtRepliedAll               Boolean?
  waPostedStatus                 Boolean?
  waSavedContacts                Boolean?
  waRespondedAll                 Boolean?
  waPosted10Statuses             Boolean?
  waSaved10Contacts              Boolean?
  stockEnoughFastMovers          Boolean?
  shot4ProductVideos             Boolean?
  tiktokPosted4ExplanatoryVideos Boolean?
  liveViewers                    Int?
  liveSessionsCount              Int?
  liveSessionsEstimatedViewers   Int?
  liveSessionDurationMinutes     Int?
  liveSessionPlatform            String?
  shopCleaned                    Boolean?
  shopWellArranged               Boolean?
  displayWellLabeled             Boolean?
  weeklyComment                  String?
  payload                        Json?
  submittedById                  String?
  submittedByName                String?
  submittedByEmail               String?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  weeklyMeetingAttended          Boolean?           @default(false)
  weeklyVideoCount               Int?               @default(0)
  weeklyVideoShootParticipated   Boolean?           @default(false)
  submittedBy                    User?              @relation(fields: [submittedById], references: [id])
  receipts                       MarketingReceipt[]
  sales                          MarketingSale[]

  @@index([date])
  @@index([dayOfWeek])
  @@index([submittedById])
}

model MarketingSale {
  id            String              @id @default(cuid())
  entryId       String
  product       String
  buyingPrice   Int
  sellingPrice  Int
  receiptNumber String?
  paymentMethod PaymentMethod
  createdAt     DateTime            @default(now())
  itemsCount    Int                 @default(1)
  dailySaleId   String?
  dailySale     DailySale?          @relation(fields: [dailySaleId], references: [id])
  entry         MarketingDailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([dailySaleId])
}

model MarketingReceipt {
  id            String                 @id @default(cuid())
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  dailyEntryId  String
  receiptNumber String?
  sellingTotal  Int
  paymentMethod PaymentMethod
  dailyEntry    MarketingDailyEntry    @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  items         MarketingReceiptItem[]
  buyingTotal   Int                    @default(0)

  @@index([dailyEntryId])
}

model MarketingReceiptItem {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  receiptId   String
  productName String
  buyingPrice Int
  receipt     MarketingReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model SupportDailyEntry {
  id               String           @id @default(cuid())
  date             DateTime
  dayOfWeek        String
  totalSales       Int              @default(0)
  totalProfit      Int              @default(0)
  newBatteries     Int              @default(0)
  changedBatteries Int              @default(0)
  submittedById    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  submittedBy      User?            @relation(fields: [submittedById], references: [id])
  receipts         SupportReceipt[] @relation("SupportEntryReceipts")
  sales            SupportSale[]    @relation("SupportEntrySales")

  @@index([date])
  @@index([submittedById])
}

model SupportSale {
  id            String            @id @default(cuid())
  entryId       String
  product       String
  buyingPrice   Int
  sellingPrice  Int
  receiptNumber String?
  paymentMethod PaymentMethod
  itemsCount    Int               @default(1)
  createdAt     DateTime          @default(now())
  entry         SupportDailyEntry @relation("SupportEntrySales", fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model SupportReceipt {
  id            String               @id @default(cuid())
  dailyEntryId  String
  receiptNumber String?
  sellingTotal  Int
  paymentMethod PaymentMethod
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  dailyEntry    SupportDailyEntry    @relation("SupportEntryReceipts", fields: [dailyEntryId], references: [id], onDelete: Cascade)
  items         SupportReceiptItem[] @relation("SupportReceiptItems")
  buyingTotal   Int                  @default(0)

  @@index([dailyEntryId])
}

model SupportReceiptItem {
  id          String         @id @default(cuid())
  receiptId   String
  productName String
  buyingPrice Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  receipt     SupportReceipt @relation("SupportReceiptItems", fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model Shop {
  id                   String                @id @default(cuid())
  name                 String
  location             String?
  phone                String?
  email                String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  platform             Platform              @default(JUMIA)
  /// When true, automated sync jobs should skip fetching orders for this shop.
  disableAutoSync      Boolean               @default(false)
  credentialsEncrypted Json?
  apiCredentials       ApiCredential[]
  attendantCommissions AttendantCommission[]
  commissionRules      CommissionRule[]
  costCatalogs         CostCatalog[]
  discrepancies        Discrepancy[]
  fulfillmentAudits    FulfillmentAudit[]
  orders               Order[]
  reconciliations      Reconciliation[]
  returnCases          ReturnCase[]
  settlementRows       SettlementRow[]
  apiConfig            ShopApiConfig?
  assignments          ShopAssignment[]
  userAssignments      UserShop[]
  managers             User[]                @relation("ManagedBy")
  weeklySales          WeeklySale[]
}

/// WeeklySale records aggregate the total sales for a given attendant (user) and shop
/// over a Monday→Saturday week. Each record can be marked as PENDING or PAID.
model WeeklySale {
  id         String            @id @default(cuid())
  userId     String?
  shopId     String?
  platform   Platform
  weekStart  DateTime
  weekEnd    DateTime
  amount     Decimal           @db.Decimal(12, 2)
  source     WeeklySaleSource  @default(AUTOMATIC)
  status     WeeklySaleStatus  @default(PENDING)
  createdBy  String?
  approvedBy String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  shop     Shop?   @relation(fields: [shopId], references: [id])
  user     User?   @relation("WeeklySaleAttendant", fields: [userId], references: [id])
  approved User?   @relation("WeeklySaleApproval", fields: [approvedBy], references: [id])

  @@index([shopId, platform, weekStart, weekEnd])
  @@unique([shopId, platform, weekStart, weekEnd], map: "WeeklySale_shopId_platform_weekStart_weekEnd_key")
}

model JumiaAccount {
  id           String      @id @default(cuid())
  label        String
  clientId     String
  refreshToken String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  shops        JumiaShop[]
}

model JumiaShop {
  id                      String       @id
  name                    String
  accountId               String
  lastOrdersUpdatedBefore DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  orders                  JumiaOrder[]
  account                 JumiaAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

model JumiaOrder {
  id                       String    @id
  number                   Int?
  status                   String
  hasMultipleStatus        Boolean?
  pendingSince             String?
  totalItems               Int?
  packedItems              Int?
  countryCode              String?
  isPrepayment             Boolean?
  createdAtJumia           DateTime?
  updatedAtJumia           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  shopId                   String
  totalAmountLocalCurrency String?
  totalAmountLocalValue    Float?
  shopName                 String?
  shop                     JumiaShop @relation(fields: [shopId], references: [id])

  @@index([shopId, status])
  @@index([updatedAtJumia])
  @@index([createdAtJumia])
  @@index([shopId, updatedAtJumia])
}

model ShopApiConfig {
  id        String   @id @default(cuid())
  shopId    String   @unique
  platform  String   @default("JUMIA")
  apiKey    String
  apiSecret String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id])
}

model Product {
  id              String      @id @default(cuid())
  sku             String      @unique
  name            String
  category        String
  sellingPrice    Float
  lastBuyingPrice Float?
  minStockLevel   Int         @default(5)
  stockQuantity   Int         @default(0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orders          OrderItem[]
}

model Order {
  id             String          @id @default(cuid())
  orderNumber    String          @unique
  customerName   String
  customerPhone  String?
  customerEmail  String?
  metadata       Json?
  shopId         String
  attendantId    String?
  status         OrderStatus     @default(PENDING)
  totalAmount    Float
  paidAmount     Float           @default(0)
  paymentStatus  PaymentStatus   @default(UNPAID)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attendant      User?           @relation(fields: [attendantId], references: [id])
  shop           Shop            @relation(fields: [shopId], references: [id])
  items          OrderItem[]
  returnCases    ReturnCase[]
  settlementRows SettlementRow[]
  // One-to-one receipt created for this order (if any)
  receipt        Receipt?
  // Commission records created for this order
  commissionRecords CommissionRecord[]
  // Optional layaway plan attached to this order
  layawayPlan    LayawayPlan?
}

model OrderItem {
  id                 String              @id @default(cuid())
  orderId            String
  productId          String
  quantity           Int
  sellingPrice       Float
  commissionEarnings CommissionEarning[]
  orderCosts         OrderCost[]
  order              Order               @relation(fields: [orderId], references: [id])
  product            Product             @relation(fields: [productId], references: [id])
  profitSnapshots    ProfitSnapshot[]
  returnAdjustments  ReturnAdjustment[]
  returnCases        ReturnCase[]
  settlementRows     SettlementRow[]
  serial             String?
  warranty           String?
}

/// Commission configuration and snapshots
model CommissionPeriod {
  id                   String                @id @default(cuid())
  name                 String
  startDate            DateTime
  endDate              DateTime
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  attendantCommissions AttendantCommission[]
  tiers                CommissionTier[]
}

model CommissionTier {
  id         String           @id @default(cuid())
  periodId   String
  minSales   Float
  maxSales   Float
  payoutFlat Float
  period     CommissionPeriod @relation(fields: [periodId], references: [id])
}

model AttendantCommission {
  id         String           @id @default(cuid())
  userId     String
  periodId   String
  shopId     String?
  sales      Float
  payout     Float
  computedAt DateTime         @default(now())
  period     CommissionPeriod @relation(fields: [periodId], references: [id])
  shop       Shop?            @relation(fields: [shopId], references: [id])
  user       User             @relation(fields: [userId], references: [id])
}

model ApiCredential {
  id           String   @id @default(cuid())
  scope        String
  apiBase      String
  apiKey       String?
  apiSecret    String?
  issuer       String?
  clientId     String?
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shopId       String?
  shop         Shop?    @relation(fields: [shopId], references: [id])

  @@unique([scope, shopId])
}

model Config {
  key       String   @id
  json      Json
  updatedAt DateTime @updatedAt
}

model CostCatalog {
  id            String    @id @default(cuid())
  sku           String
  shopId        String?
  cost          Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  shop          Shop?     @relation(fields: [shopId], references: [id])

  @@index([sku, shopId, effectiveFrom])
}

model OrderCost {
  id          String    @id @default(cuid())
  orderItemId String
  unitCost    Decimal   @db.Decimal(12, 2)
  costSource  String
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model SettlementRow {
  id          String     @id @default(cuid())
  shopId      String
  orderId     String?
  orderItemId String?
  kind        String
  amount      Decimal    @db.Decimal(12, 2)
  ref         String?
  postedAt    DateTime
  raw         Json
  createdAt   DateTime   @default(now())
  order       Order?     @relation(fields: [orderId], references: [id])
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  shop        Shop       @relation(fields: [shopId], references: [id])

  @@index([shopId, postedAt])
  @@index([orderId, orderItemId])
}

model ProfitSnapshot {
  id          String    @id @default(cuid())
  orderItemId String
  revenue     Decimal   @db.Decimal(12, 2)
  fees        Decimal   @db.Decimal(12, 2)
  shipping    Decimal   @db.Decimal(12, 2)
  refunds     Decimal   @db.Decimal(12, 2)
  unitCost    Decimal   @db.Decimal(12, 2)
  qty         Int
  profit      Decimal   @db.Decimal(12, 2)
  computedAt  DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
}

model CommissionRule {
  id            String    @id @default(cuid())
  scope         String
  shopId        String?
  sku           String?
  category      String?
  type          String
  rateDecimal   Decimal   @db.Decimal(6, 4)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  shop          Shop?     @relation(fields: [shopId], references: [id])

  @@index([scope, shopId, sku, category, effectiveFrom])
}

model CommissionEarning {
  id          String    @id @default(cuid())
  staffId     String
  orderItemId String
  basis       String
  qty         Int
  amount      Decimal   @db.Decimal(12, 2)
  status      String
  calcDetail  Json
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  staff       User      @relation(fields: [staffId], references: [id])
}

model ReturnCase {
  id          String             @id @default(cuid())
  shopId      String
  orderId     String
  orderItemId String?
  reasonCode  String
  status      String
  resolution  String?
  createdBy   String
  approvedBy  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  dueAt       DateTime?
  pickedAt    DateTime?
  adjustments ReturnAdjustment[]
  approver    User?              @relation("ReturnApprovedBy", fields: [approvedBy], references: [id])
  creator     User               @relation("ReturnCreatedBy", fields: [createdBy], references: [id])
  order       Order              @relation(fields: [orderId], references: [id])
  orderItem   OrderItem?         @relation(fields: [orderItemId], references: [id])
  shop        Shop               @relation(fields: [shopId], references: [id])
  evidence    ReturnEvidence[]
  pickups     ReturnPickup[]

  @@index([shopId, status])
}

model ReturnPickup {
  id           String     @id @default(cuid())
  returnCaseId String
  scheduledAt  DateTime
  carrier      String
  tracking     String?
  assignedTo   String
  notes        String?
  createdAt    DateTime   @default(now())
  assignee     User       @relation("PickupAssignee", fields: [assignedTo], references: [id])
  returnCase   ReturnCase @relation(fields: [returnCaseId], references: [id])
}

model ReturnEvidence {
  id           String     @id @default(cuid())
  returnCaseId String
  type         String
  uri          String
  sha256       String
  takenBy      String
  takenAt      DateTime
  geo          Json?
  createdAt    DateTime   @default(now())
  returnCase   ReturnCase @relation(fields: [returnCaseId], references: [id])
  taker        User       @relation("EvidenceTaker", fields: [takenBy], references: [id])
}

model ReturnAdjustment {
  id               String     @id @default(cuid())
  returnCaseId     String
  orderItemId      String
  amount           Decimal    @db.Decimal(12, 2)
  commissionImpact String
  notes            String?
  createdAt        DateTime   @default(now())
  orderItem        OrderItem  @relation(fields: [orderItemId], references: [id])
  returnCase       ReturnCase @relation(fields: [returnCaseId], references: [id])
}

model ActionLog {
  id        String   @id @default(cuid())
  actorId   String
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
}

model UserShop {
  id         String         @id @default(cuid())
  userId     String
  shopId     String
  roleAtShop ShopRoleAtShop
  shop       Shop           @relation(fields: [shopId], references: [id])
  user       User           @relation(fields: [userId], references: [id])

  @@unique([userId, shopId])
}

/// Assignment model for supervisors/attendants per shop
model ShopAssignment {
  id        String   @id @default(cuid())
  userId    String
  shopId    String
  createdAt DateTime @default(now())
  role      Role
  shop      Shop     @relation(fields: [shopId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, shopId, role])
}

model AttendantCategoryAssignment {
  id         String            @id @default(cuid())
  userId     String
  category   AttendantCategory
  assignedAt DateTime          @default(now())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([category])
}

model ProductCost {
  id        String      @id @default(cuid())
  productId String
  price     Decimal     @db.Decimal(12, 2)
  byUserId  String?
  createdAt DateTime    @default(now())
  source    PriceSource

  @@index([productId])
}

model CommissionLedger {
  id              String   @id @default(cuid())
  userId          String
  periodStart     DateTime
  periodEnd       DateTime
  grossCommission Decimal  @default(0) @db.Decimal(12, 2)
  penalties       Decimal  @default(0) @db.Decimal(12, 2)
  netCommission   Decimal  @default(0) @db.Decimal(12, 2)
  detail          Json?
  createdAt       DateTime @default(now())

  @@unique([userId, periodStart, periodEnd], name: "userId_periodStart_periodEnd")
}

model Balance {
  id        String   @id @default(cuid())
  userId    String   @unique
  available Decimal  @default(0) @db.Decimal(14, 2)
  pending   Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Reconciliation {
  id           String   @id @default(cuid())
  shopId       String
  day          DateTime
  ordersCount  Int
  payoutAmount Decimal  @default(0) @db.Decimal(12, 2)
  variance     Decimal  @default(0) @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime @default(now())
  shop         Shop     @relation(fields: [shopId], references: [id])

  @@unique([shopId, day])
}

model Discrepancy {
  id        String            @id @default(cuid())
  shopId    String
  ref       String
  amount    Decimal           @default(0) @db.Decimal(12, 2)
  createdAt DateTime          @default(now())
  kind      DiscrepancyType
  status    DiscrepancyStatus @default(OPEN)
  shop      Shop              @relation(fields: [shopId], references: [id])
}

model FulfillmentAudit {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  shopId         String
  orderId        String
  status         Int
  ok             Boolean
  payload        Json
  s3Bucket       String?
  s3Key          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  action         String?
  shop           Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId, orderId])
}

/// Persisted catalog counters (per shop and aggregate "ALL")
model CatalogCounters {
  id          String   @id @default(cuid())
  scope       String
  shopId      String?
  total       Int      @default(0)
  active      Int      @default(0)
  inactive    Int      @default(0)
  deleted     Int      @default(0)
  pending     Int      @default(0)
  visibleLive Int      @default(0)
  qcApproved  Int      @default(0)
  qcPending   Int      @default(0)
  qcRejected  Int      @default(0)
  qcNotReady  Int      @default(0)
  byStatus    Json?
  byQcStatus  Json?
  approx      Boolean  @default(false)
  computedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, shopId])
  @@index([scope, shopId, computedAt])
}

