  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  account         MarketplaceAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, statementNumber])
  @@unique([statementNumber, weekStart])
  @@index([accountId, weekEnd])
}

model MarketplaceOrder {
  id           String                  @id @default(cuid())
  accountId    String
  platform     Platform
  orderId      String
  orderItemId  String
  status       String
  orderedAt    DateTime
  productName  String
  productUrl   String?
  sellingPrice Decimal                 @db.Decimal(14, 2)
  currency     String                  @default("KES")
  buyingPrice  Decimal?                @db.Decimal(14, 2)
  sellerFee    Decimal?                @db.Decimal(14, 2)
  shippingFee  Decimal?                @db.Decimal(14, 2)
  profit       Decimal?                @db.Decimal(14, 2)
  pricedById   String?
  pricedAt     DateTime?
  isReturned   Boolean                 @default(false)
  profitEvents ProfitEvent[]
  rawPayload   Json
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  account      MarketplaceAccount      @relation(fields: [accountId], references: [id])
  pricedBy     User?                   @relation("MarketplaceOrder_pricedBy", fields: [pricedById], references: [id])
  returns      MarketplaceReturn[]     @relation("MarketplaceOrder_returns")
  events       MarketplaceOrderEvent[]

  @@unique([platform, orderItemId])
  @@index([accountId, orderedAt])
  @@index([pricedById])
}

model ProfitEvent {
  id                 String           @id @default(cuid())
  marketplaceOrderId String
  type               ProfitEventType
  amount             Decimal          @db.Decimal(14, 2)
  createdAt          DateTime         @default(now())
  marketplaceOrder   MarketplaceOrder @relation(fields: [marketplaceOrderId], references: [id])

  @@unique([marketplaceOrderId, type])
  @@index([marketplaceOrderId])
}

model MarketplacePricingTemplate {
  id                    String   @id @default(cuid())
  platform              Platform
  normalizedProductName String
  sellingPrice          Decimal  @db.Decimal(14, 2)
  defaultBuyingPrice    Decimal  @db.Decimal(14, 2)
  updatedById           String?
  updatedAt             DateTime @default(now())
  updatedBy             User?    @relation("MarketplacePricingTemplate_updatedBy", fields: [updatedById], references: [id])

  @@unique([platform, normalizedProductName, sellingPrice])
}

model MarketplaceReturn {
  id                   String                        @id @default(cuid())
  accountId            String
  platform             Platform
  marketplaceOrderId   String?
  orderItemId          String
  attendantId          String?
  expectedAmount       Decimal                       @db.Decimal(14, 2)
  status               MarketplaceReturnStatus       @default(WAITING_AT_HUB)
  createdAt            DateTime                      @default(now())
  dueAt                DateTime
  processedById        String?
  processedAt          DateTime?
  notes                String?
  rawPayload           Json?
  sourceEmailMessageId String?
  account              MarketplaceAccount            @relation(fields: [accountId], references: [id])
  attendant            User?                         @relation("MarketplaceReturn_attendant", fields: [attendantId], references: [id])
  marketplaceOrder     MarketplaceOrder?             @relation("MarketplaceOrder_returns", fields: [marketplaceOrderId], references: [id])
  processedBy          User?                         @relation("MarketplaceReturn_processedBy", fields: [processedById], references: [id])
  sourceEmailMessage   MarketplaceEmailMessage?      @relation("MarketplaceReturn_sourceEmailMessage", fields: [sourceEmailMessageId], references: [id])
  attachments          MarketplaceReturnAttachment[]

  @@unique([platform, orderItemId])
  @@index([attendantId, status])
  @@index([dueAt, status])
  @@index([sourceEmailMessageId])
}

model MarketplaceReturnAttachment {
  id           String            @id @default(cuid())
  returnId     String
  url          String
  uploadedById String
  createdAt    DateTime          @default(now())
  returnRef    MarketplaceReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  uploadedBy   User              @relation("MarketplaceReturnAttachment_uploadedBy", fields: [uploadedById], references: [id])

  @@index([returnId])
}

model MarketplaceMailbox {
  id                String                        @id @default(cuid())
  email             String                        @unique
  displayName       String?
  isActive          Boolean                       @default(true)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  oauth             MarketplaceMailboxOAuth?
  messages          MarketplaceEmailMessage[]
  afterSalesThreads MarketplaceAfterSalesThread[]
}

model MarketplaceMailboxOAuth {
  id           String             @id @default(cuid())
  mailboxId    String             @unique
  refreshToken String
  scope        String?
  tokenSource  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  mailbox      MarketplaceMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
}

enum MarketplaceEmailParserType {
  UNKNOWN
  JUMIA_DAILY_REPORT
  JUMIA_RETURN_PICKUP
  KILIMALL_NEW_ORDER
  KILIMALL_AFTERSALES
}

enum MarketplaceEmailParseStatus {
  SKIPPED
  PARSED
  FAILED
}

enum MarketplaceEmailParseSource {
  RULE_BASED
  AI_FALLBACK
  AI_FALLBACK_FAILED
}

model MarketplaceEmailMessage {
  id             String                      @id @default(cuid())
  mailboxId      String
  /// Provider message id (Gmail message id). Used for global de-dupe.
  providerMsgId  String                      @unique
  gmailMessageId String
  threadId       String?
  fromEmail      String?
  subject        String?
  receivedAt     DateTime
  snippet        String?
  rawHeaders     Json?
  rawBodyHtml    String?
  rawBodyText    String?
  parserType     MarketplaceEmailParserType  @default(UNKNOWN)
  parseStatus    MarketplaceEmailParseStatus @default(SKIPPED)
  parseSource    MarketplaceEmailParseSource @default(RULE_BASED)
  parseError     String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  mailbox              MarketplaceMailbox                    @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  dailyDigests         MarketplaceDailyOrderDigest[]         @relation("DailyDigest_sourceMessage")
  dailyDigestSnapshots MarketplaceDailyOrderDigestSnapshot[] @relation("DailyDigestSnapshot_sourceMessage")
  orderEvents          MarketplaceOrderEvent[]               @relation("OrderEvent_sourceMessage")
  afterSales           MarketplaceAfterSalesThread[]         @relation("AfterSales_sourceMessage")
  returns              MarketplaceReturn[]                   @relation("MarketplaceReturn_sourceEmailMessage")

  @@unique([mailboxId, gmailMessageId])
  @@index([mailboxId, receivedAt])
  @@index([parserType, parseStatus])
}

model MarketplaceDailyOrderDigest {
  id              String    @id @default(cuid())
  accountId       String
  platform        Platform
  /// Date-only stored as DateTime at 00:00:00Z.
  digestDate      DateTime
  newOrders       Int       @default(0)
  pendingToday    Int       @default(0)
  readyToShip     Int       @default(0)
  returnedToday   Int       @default(0)
  cancelledToday  Int       @default(0)
  deliveredToday  Int       @default(0)
  deliveryFailed  Int       @default(0)
  sourceMessageId String?
  lastReceivedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account       MarketplaceAccount       @relation(fields: [accountId], references: [id])
  sourceMessage MarketplaceEmailMessage? @relation("DailyDigest_sourceMessage", fields: [sourceMessageId], references: [id])

  @@unique([accountId, platform, digestDate])
  @@index([platform, digestDate])
}

enum MarketplaceDigestBucket {
  MORNING
  MIDDAY
}

/// Stores multiple Jumia digest snapshots per day (e.g., 7am and 1pm emails).
/// The existing MarketplaceDailyOrderDigest remains a single "latest" per day.
model MarketplaceDailyOrderDigestSnapshot {
  id              String                  @id @default(cuid())
  accountId       String
  platform        Platform
  /// Date-only stored as DateTime at 00:00:00Z.
  digestDate      DateTime
  bucket          MarketplaceDigestBucket
  newOrders       Int                     @default(0)
  pendingToday    Int                     @default(0)
  readyToShip     Int                     @default(0)
  returnedToday   Int                     @default(0)
  cancelledToday  Int                     @default(0)
  deliveredToday  Int                     @default(0)
  deliveryFailed  Int                     @default(0)
  sourceMessageId String?
  receivedAt      DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  account       MarketplaceAccount       @relation(fields: [accountId], references: [id])
  sourceMessage MarketplaceEmailMessage? @relation("DailyDigestSnapshot_sourceMessage", fields: [sourceMessageId], references: [id])

  @@unique([accountId, platform, digestDate, bucket])
  @@index([platform, digestDate, bucket])
  @@index([accountId, digestDate])
}

model MarketplaceOrderEvent {
  id                 String   @id @default(cuid())
  marketplaceOrderId String
  platform           Platform
  status             String
  occurredAt         DateTime @default(now())
  sourceMessageId    String?
  rawPayload         Json?
  createdAt          DateTime @default(now())

  marketplaceOrder MarketplaceOrder         @relation(fields: [marketplaceOrderId], references: [id], onDelete: Cascade)
  sourceMessage    MarketplaceEmailMessage? @relation("OrderEvent_sourceMessage", fields: [sourceMessageId], references: [id])

  @@unique([marketplaceOrderId, status])
  @@index([marketplaceOrderId, occurredAt])
}

enum MarketplaceAfterSalesStatus {
  OPEN
  RESOLVED
}

model MarketplaceAfterSalesThread {
  id              String                      @id @default(cuid())
  accountId       String?
  platform        Platform                    @default(KILIMALL)
  mailboxId       String
  sourceMessageId String                      @unique
  subject         String?
  fromEmail       String?
  receivedAt      DateTime
  status          MarketplaceAfterSalesStatus @default(OPEN)
  keywords        String[]                    @default([])
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  account       MarketplaceAccount?     @relation(fields: [accountId], references: [id])
  mailbox       MarketplaceMailbox      @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  sourceMessage MarketplaceEmailMessage @relation("AfterSales_sourceMessage", fields: [sourceMessageId], references: [id], onDelete: Cascade)

  @@index([platform, status, receivedAt])
  @@index([accountId, status])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model acc_id {
  id String?

  @@ignore
}

model schema_reconciliation_log {
  id         Int       @id @default(autoincrement())
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  action     String
  detail     String?
}

