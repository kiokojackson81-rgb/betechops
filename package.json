{
  "name": "betechops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/vercel-build.js",
    "vercel-build": "node scripts/vercel-build.js",
    "start": "next start",
    "lint": "eslint",
    "prisma:seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "node ./scripts/postinstall.js",
    "setup:hooks": "git config core.hooksPath .githooks",
    "verify:no-conflicts": "node scripts/precommit-check.js",
    "set-admin": "node scripts/set-admin.js",
    "seed:shops": "node -r ts-node/register scripts/seed-shops.ts",
    "seed:shops:remote": "ts-node --esm --transpile-only scripts/seed-shops-remote.ts",
    "test": "jest --passWithNoTests",
    "test:smoke": "node tests/smoke/users-search.js && node tests/smoke/uploads-sign.js && node tests/smoke/shops-assign.js",
    "smoke:local": "node scripts/smoke/test-apis.js",
    "run-jumia-sync": "node -r ts-node/register scripts/run-jumia-sync.ts",
    "weekly-sales:sync": "node -r ts-node/register scripts/sync-and-backfill-weekly-sales.ts",
    "backfill:catalog-counters": "node -r ts-node/register -r tsconfig-paths/register scripts/backfill-catalog-counters.js",
    "backfill:daily-report-metrics": "node -r ts-node/register -r tsconfig-paths/register scripts/backfill-daily-report-metrics.ts",
    "cleanup:jumia-orders": "node scripts/run-cleanup.cjs",
    "sync:jumia-shops": "ts-node --transpile-only scripts/sync-jumia-shops.ts",
    "discover:providers": "node --loader ts-node/esm -r tsconfig-paths/register scripts/discover-providers.ts",
    "job:jumia-sync-incremental": "curl -s -X POST http://localhost:3000/api/jumia/jobs/sync-incremental || true",
    "worker:jumia-sync": "npm run build:worker --silent && node .worker-dist/scripts/jumia-sync-worker.js",
    "build:worker": "tsc -p tsconfig.worker.json",
    "debug:prisma:check": "node scripts/prisma-connect-check.js",
    "recompute:wrapper": "node scripts/recompute-wrapper.js",
    "set:default-providers": "ts-node --esm --transpile-only scripts/set-default-providers.ts",
    "list:shops": "ts-node --esm --transpile-only scripts/list-shops.ts",
    "shops:export": "ts-node --esm --transpile-only scripts/export-shops.ts",
    "set:default-providers:ids": "ts-node --esm --transpile-only scripts/set-default-providers-by-id.ts",
    "dedupe:shops": "ts-node --esm --transpile-only scripts/dedupe-shops.ts shops.secrets.json",
    "fix:duplicate-betech-store": "ts-node --esm --transpile-only scripts/remove-duplicate-betech-store.ts",
    "backfill:jumia:order-totals": "node -r ts-node/register -r tsconfig-paths/register scripts/backfill-jumia-order-totals.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@sendgrid/mail": "^8.1.6",
    "@sparticuz/chromium": "^143.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@vercel/blob": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "dotenv": "^17.2.3",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.544.0",
    "next": "16.0.7",
    "next-auth": "^4.24.11",
    "nodemailer": "^6.10.1",
    "openai": "^6.10.0",
    "p-limit": "^4.0.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pino": "^8.0.0",
    "prom-client": "^14.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "twilio": "^4.13.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@prisma/client": "^6.19.0",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "jest": "^29.6.1",
    "pg": "^8.16.3",
    "playwright": "^1.40.0",
    "prisma": "^6.18.0",
    "puppeteer": "^21.11.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "optionalDependencies": {
    "puppeteer": "^21.11.0",
    "puppeteer-core": "^24.31.0"
  }
}
