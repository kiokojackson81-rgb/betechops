{
  "buildCommand": "node scripts/vercel-build.js",
  "crons": [
    {
      "path": "/api/admin/catalog/counters/recompute",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/jumia/jobs/sync-incremental",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/jumia/sync-pending",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/online/email-ingest",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/reviews-referrals/invitations",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "src/app/api/receipts/**": {
      "maxDuration": 60
    },
    "src/app/api/cron/online/email-ingest/**": {
      "maxDuration": 300
    }
  }
}
