{
  "crons": [
    {
      "path": "/api/admin/catalog/counters/recompute",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/jumia/jobs/sync-incremental",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/jumia/sync-pending",
      "schedule": "*/1 * * * *"
    }
  ],
  "functions": {
    "api/receipts/**": {
      "maxDuration": 60
    },
    "src/app/api/receipts/**": {
      "maxDuration": 60
    }
  }
}
